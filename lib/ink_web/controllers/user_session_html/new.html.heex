<Layouts.app flash={@flash} current_user={@current_user}>
  <div class="flex min-h-[70vh] flex-col items-center justify-center gap-8 px-2">
    <div class="text-center">
      <img
        src={~p"/images/logo.png"}
        alt="Ink"
        class="mx-auto h-20 w-auto object-contain sm:h-24"
      />
      <p class="mt-2 font-display text-2xl font-semibold tracking-[-0.02em] text-foreground sm:text-3xl">
        Bienvenido
      </p>
      <p class="mt-2 text-sm text-muted-foreground">Inicia sesión para continuar</p>
    </div>

    <div class="mx-auto w-full max-w-md rounded-2xl bg-surface-container-low p-6 sm:p-8">
      <.form for={@form} id="login-form" action={~p"/login"} method="post" class="space-y-4">
        <.input field={@form[:email]} type="email" label="Email" autocomplete="username" required />
        <.input
          field={@form[:password]}
          type="password"
          label="Password"
          autocomplete="current-password"
          required
        />

        <.button type="submit" class="w-full">
          Entrar
        </.button>
      </.form>

      <p class="mt-6 text-center text-sm text-muted-foreground">
        ¿No tienes cuenta?
        <.link href={~p"/register"} class="font-semibold text-primary hover:text-primary-deep">
          Crear cuenta
        </.link>
      </p>
    </div>
  </div>
</Layouts.app>
