<Layouts.app flash={@flash} current_user={@current_user}>
  <div class="mx-auto w-full max-w-md rounded-2xl border border-base-300 bg-base-100 p-6 shadow-sm">
    <h1 class="text-2xl font-semibold text-base-content">Crear cuenta</h1>
    <p class="mt-2 text-sm text-base-content/70">
      Regístrate para guardar y compartir tus rooms.
    </p>

    <.form
      for={@form}
      id="register-form"
      action={~p"/register"}
      method="post"
      class="mt-6 space-y-4"
    >
      <.input field={@form[:email]} type="email" label="Email" required />
      <.input field={@form[:password]} type="password" label="Password" required />

      <button type="submit" class="btn btn-primary w-full">
        Crear cuenta
      </button>
    </.form>

    <p class="mt-4 text-center text-sm text-base-content/70">
      ¿Ya tienes cuenta?
      <.link href={~p"/login"} class="font-medium text-primary hover:text-primary/80">
        Iniciar sesión
      </.link>
    </p>
  </div>
</Layouts.app>
