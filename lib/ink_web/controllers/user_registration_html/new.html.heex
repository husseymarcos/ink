<Layouts.app flash={@flash} current_user={@current_user}>
  <div class="flex min-h-[70vh] flex-col items-center justify-center gap-6">
    <div class="text-center">
      <img
        src={~p"/images/logo.png"}
        alt="Ink"
        class="mx-auto h-20 w-auto object-contain sm:h-24"
      />
      <p class="mt-3 text-5xl font-black tracking-tight text-primary sm:text-6xl">Ink</p>
      <p class="mt-2 text-sm text-base-content/70">Crea tu cuenta para continuar</p>
    </div>

    <div class="mx-auto w-full max-w-md rounded-2xl border border-base-300 bg-base-100 p-6 shadow-sm">
      <.form
        for={@form}
        id="register-form"
        action={~p"/register"}
        method="post"
        class="space-y-4"
      >
        <.input field={@form[:email]} type="email" label="Email" autocomplete="email" required />
        <.input
          field={@form[:password]}
          type="password"
          label="Password"
          autocomplete="new-password"
          required
        />

        <button type="submit" class="btn btn-primary w-full">
          Crear cuenta
        </button>
      </.form>

      <p class="mt-4 text-center text-sm text-base-content/70">
        ¿Ya tienes cuenta?
        <.link href={~p"/login"} class="font-medium text-primary hover:text-primary/80">
          Iniciar sesión
        </.link>
      </p>
    </div>
  </div>
</Layouts.app>
