<Layouts.flash_group flash={@flash} />
<div class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary-deep/15 via-surface to-tertiary/10"
    aria-hidden="true"
  >
  </div>

  <div class="relative px-4 py-16 sm:px-6 sm:py-24 lg:px-12 lg:py-28">
    <div class="mx-auto flex max-w-6xl flex-col gap-12 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-xl">
        <p class="text-xs font-semibold uppercase tracking-wider text-tertiary">
          Ink
        </p>
        <h1 class="font-display mt-4 text-4xl font-semibold tracking-[-0.02em] text-foreground sm:text-5xl sm:leading-tight">
          The Digital Vellum
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
          Un lienzo colaborativo con la autoridad de la tipografía editorial y la calma de superficies en capas.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-start gap-3 lg:justify-end">
        <.button navigate={~p"/login"} class="px-6 py-3 normal-case tracking-normal">
          Entrar
        </.button>
        <.button navigate={~p"/register"} variant="secondary" class="px-6 py-3">
          Crear cuenta
        </.button>
      </div>
    </div>
  </div>
</div>
