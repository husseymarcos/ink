<Layouts.app flash={@flash} current_scope={%{}} current_user={@current_user}>
  <div class="flex w-full min-h-[calc(100dvh-6rem)] items-center justify-center py-8 sm:py-10">
    <main class={[
      "w-full max-w-md rounded-xl bg-surface-container-lowest p-8 shadow-sm ring-1 ring-outline-variant/15",
      "md:p-12"
    ]}>
      <%!-- Brand header --%>
      <div class="mb-10 flex flex-col items-center">
        <img
          src={~p"/images/logo.png"}
          alt="Ink"
          class="mb-4 h-32 w-32 object-contain sm:h-40 sm:w-40"
        />
        <h1 class="font-display text-2xl font-extrabold tracking-tight text-foreground">
          Create your account
        </h1>
        <p class="mt-1 text-sm text-on-surface-variant">
          Start your journey with Ink today
        </p>
      </div>

      <.form for={@form} id="register-form" phx-submit="register" class="space-y-6">
        <div class="space-y-1.5">
          <label
            for={@form[:name].id}
            class="block px-1 text-[11px] font-bold uppercase tracking-wider text-on-surface-variant"
          >
            Full name
          </label>
          <div class="group relative">
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 flex items-center pl-4">
              <.icon
                name="hero-user"
                class="size-[18px] text-outline transition-colors group-focus-within:text-primary"
              />
            </div>
            <input
              type="text"
              name={@form[:name].name}
              id={@form[:name].id}
              value={Phoenix.HTML.Form.normalize_value("text", @form[:name].value)}
              autocomplete="name"
              placeholder="Enter your full name"
              class={[
                "relative z-0 block w-full rounded-full border-0 bg-surface py-3 pr-4 pl-11 text-sm text-foreground",
                "shadow-none ring-1 ring-outline-variant/30 transition-all outline-none",
                "placeholder:text-outline/40",
                "focus:ring-2 focus:ring-primary",
                @form[:name].errors != [] && "ring-2 ring-red-500/80"
              ]}
            />
          </div>
          <div :if={@form[:name].errors != []} class="space-y-1 px-1">
            <p :for={err <- @form[:name].errors} class="text-sm text-red-600">
              {translate_error(err)}
            </p>
          </div>
        </div>

        <div class="space-y-1.5">
          <label
            for={@form[:email].id}
            class="block px-1 text-[11px] font-bold uppercase tracking-wider text-on-surface-variant"
          >
            Email address
          </label>
          <div class="group relative">
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 flex items-center pl-4">
              <.icon
                name="hero-envelope"
                class="size-[18px] text-outline transition-colors group-focus-within:text-primary"
              />
            </div>
            <input
              type="email"
              name={@form[:email].name}
              id={@form[:email].id}
              value={Phoenix.HTML.Form.normalize_value("email", @form[:email].value)}
              autocomplete="email"
              required
              placeholder="name@company.com"
              class={[
                "relative z-0 block w-full rounded-full border-0 bg-surface py-3 pr-4 pl-11 text-sm text-foreground",
                "shadow-none ring-1 ring-outline-variant/30 transition-all outline-none",
                "placeholder:text-outline/40",
                "focus:ring-2 focus:ring-primary",
                @form[:email].errors != [] && "ring-2 ring-red-500/80"
              ]}
            />
          </div>
          <div :if={@form[:email].errors != []} class="space-y-1 px-1">
            <p :for={err <- @form[:email].errors} class="text-sm text-red-600">
              {translate_error(err)}
            </p>
          </div>
        </div>

        <div class="space-y-1.5">
          <label
            for={@form[:password].id}
            class="block px-1 text-[11px] font-bold uppercase tracking-wider text-on-surface-variant"
          >
            Password
          </label>
          <div
            id="register-password-row"
            phx-hook="PasswordToggle"
            class="group relative"
          >
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 flex items-center pl-4">
              <.icon
                name="hero-lock-closed"
                class="size-5 text-outline transition-colors group-focus-within:text-primary"
              />
            </div>
            <input
              type="password"
              name={@form[:password].name}
              id={@form[:password].id}
              value={Phoenix.HTML.Form.normalize_value("password", @form[:password].value)}
              autocomplete="new-password"
              required
              placeholder="Create a password"
              class={[
                "relative z-0 block w-full rounded-full border-0 bg-surface py-3 pr-12 pl-12 text-sm text-foreground",
                "shadow-none ring-1 ring-outline-variant/30 transition-all outline-none",
                "placeholder:text-outline/40",
                "focus:ring-2 focus:ring-primary",
                @form[:password].errors != [] && "ring-2 ring-red-500/80"
              ]}
            />
            <button
              type="button"
              data-password-toggle
              class={[
                "absolute top-1/2 right-3 z-20 size-9 -translate-y-1/2 cursor-pointer rounded-full",
                "text-outline transition-colors hover:bg-outline-variant/10 hover:text-primary"
              ]}
              aria-pressed="false"
              aria-label="Show password"
            >
              <span
                data-password-icon="show"
                class="absolute inset-0 flex items-center justify-center"
              >
                <.icon name="hero-eye" class="size-5 shrink-0" />
              </span>
              <span data-password-icon="hide" class="absolute inset-0 hidden">
                <span class="flex h-full w-full items-center justify-center">
                  <.icon name="hero-eye-slash" class="size-5 shrink-0" />
                </span>
              </span>
            </button>
          </div>
          <div :if={@form[:password].errors != []} class="space-y-1 px-1">
            <p :for={err <- @form[:password].errors} class="text-sm text-red-600">
              {translate_error(err)}
            </p>
          </div>
        </div>

        <button
          type="submit"
          class={[
            "group flex w-full items-center justify-center gap-2 rounded-full bg-primary py-3.5",
            "font-display text-sm font-bold text-on-primary shadow-md shadow-primary/10",
            "transition-all hover:shadow-primary/20 active:scale-[0.98]"
          ]}
        >
          <span>Sign up</span>
          <.icon
            name="hero-arrow-right"
            class="size-5 transition-transform group-hover:translate-x-1"
          />
        </button>
      </.form>

      <footer class="mt-10 text-center">
        <p class="text-xs font-medium text-on-surface-variant">
          Already have an account?
          <.link navigate={~p"/login"} class="ml-1 font-bold text-primary hover:underline">
            Login
          </.link>
        </p>
        <div class="mt-4 px-4">
          <p class="text-[10px] leading-relaxed text-outline">
            By signing up, you agree to our
            <a href="#" class="underline decoration-outline/20 hover:decoration-primary">
              Terms
            </a>
            and
            <a href="#" class="underline decoration-outline/20 hover:decoration-primary">
              Privacy
            </a>
          </p>
        </div>
      </footer>
    </main>
  </div>
</Layouts.app>
